# Copy to .env for local (non-Docker) runs, or use as a reference for compose overrides.

# --- Database ---
# Local default is SQLite (no setup). For Postgres:
# DATABASE_URL=postgresql+psycopg://face:face@localhost:5432/faceaccess
DATABASE_URL=sqlite:///./data/app.db

# --- Recognition tuning ---
MODEL_NAME=buffalo_l
USE_GPU=false
DET_SIZE=640
# Raise toward 0.5 for stricter (more secure) matching; lower to ~0.4 if legitimate
# people are being rejected. Calibrate with ml/benchmark.py.
RECOGNITION_THRESHOLD=0.45
MIN_FACE_PIXELS=50

# --- Camera processing ---
PROCESS_FPS=6
EVENT_DEBOUNCE_SECONDS=15
LOG_UNKNOWN=true

# --- Anti-spoofing (needs a model wired into recognition/liveness.py) ---
LIVENESS_ENABLED=false

# --- Frontend origin(s) allowed by CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Authentication ---
# Leave JWT_SECRET empty to auto-generate + persist a strong secret on first boot.
JWT_SECRET=
TOKEN_TTL_MINUTES=480
COOKIE_NAME=fac_session
# Turn COOKIE_SECURE on in production (requires HTTPS/TLS in front of the app).
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
# First-run admin. If ADMIN_PASSWORD is empty, a random one is generated and printed to
# the logs once (docker compose logs backend). Set it here to choose your own.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Brute-force protection
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_PER_MIN=10
